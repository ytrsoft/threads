<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= post.title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root { --accent: #f59e0b; --bg: #000000; --panel: #0a0a0a; --border: #1a1a1a; }
        body { background-color: var(--bg); color: #e5e5e5; font-family: 'Inter', sans-serif; }

        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: var(--bg); }
        ::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: var(--accent); }

        .font-mono { font-family: 'JetBrains Mono', monospace; }
        .nav-blur { background: rgba(0, 0, 0, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); }
        .info-cell { border: 1px solid var(--border); background: var(--panel); padding: 12px; border-radius: 2px; }
        .info-label { font-size: 10px; color: #555; text-transform: uppercase; display: block; margin-bottom: 4px; letter-spacing: 0.05em; }

        #lightbox { position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.95); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s; }
        #lightbox.active { display: flex; opacity: 1; }
        #lightbox img { max-width: 90vw; max-height: 90vh; border: 1px solid #333; user-select: none; }

        .lb-btn { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.1); color: white; border: none; padding: 15px 12px; cursor: pointer; z-index: 10000; transition: all 0.2s; border-radius: 4px; }
        .lb-btn:hover { background: var(--accent); color: black; }
        .lb-prev { left: 20px; }
        .lb-next { right: 20px; }
        @media (max-width: 768px) {
            .lb-btn { padding: 10px 8px; background: rgba(0,0,0,0.5); }
            .lb-prev { left: 10px; }
            .lb-next { right: 10px; }
        }
    </style>

    <script>
        const imgSources = [
            <% if (images && images.length) { %>
                <% images.forEach(function(img, i) { %>
                    "<%= img.src %>"<%= i < images.length - 1 ? ',' : '' %>
                <% }); %>
            <% } %>
        ];

        let currentIndex = 0;

        function handleImgError(img) {
            img.style.display = 'none';
            img.nextElementSibling.style.display = 'flex';

            const parent = img.parentElement;
            parent.onclick = null;
            parent.classList.remove('cursor-zoom-in');
            parent.classList.add('cursor-default');
        }

        function openLightbox(index) {
            if (imgSources.length === 0) return;

            currentIndex = index;
            updateLightboxImage();

            const lb = document.getElementById('lightbox');
            lb.classList.add('active');
            document.body.style.overflow = 'hidden';

            document.addEventListener('keydown', handleKeydown);
        }

        function closeLightbox() {
            const lb = document.getElementById('lightbox');
            lb.classList.remove('active');
            document.body.style.overflow = 'auto';
            document.removeEventListener('keydown', handleKeydown);
        }

        function switchImage(step, event) {
            if (event) event.stopPropagation();

            currentIndex += step;

            if (currentIndex >= imgSources.length) {
                currentIndex = 0;
            } else if (currentIndex < 0) {
                currentIndex = imgSources.length - 1;
            }

            updateLightboxImage();
        }

        function updateLightboxImage() {
            const img = document.getElementById('lightbox-img');
            img.style.opacity = '0.5';
            img.src = imgSources[currentIndex];
            setTimeout(() => img.style.opacity = '1', 150);
        }

        function handleKeydown(e) {
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') switchImage(-1);
            if (e.key === 'ArrowRight') switchImage(1);
        }
    </script>
</head>
<body class="min-h-screen pb-20">

    <div id="lightbox" onclick="closeLightbox()">
        <button class="lb-btn lb-prev" onclick="switchImage(-1, event)">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <img id="lightbox-img" src="" alt="Full View" onclick="event.stopPropagation()" class="transition-opacity duration-200">

        <button class="lb-btn lb-next" onclick="switchImage(1, event)">
            <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>

    <nav class="fixed top-0 w-full z-50 nav-blur h-14">
        <div class="max-w-[1200px] mx-auto px-4 h-full flex items-center justify-between">
            <a href="javascript:history.back()" class="flex items-center gap-2 text-xs font-bold text-gray-500 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                返回
            </a>
        </div>
    </nav>

    <main class="pt-24 px-4 max-w-[1200px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
            <div class="lg:col-span-8 space-y-10">
                <header class="border-b border-[#1a1a1a] pb-8">
                    <div class="flex items-center gap-3 mb-5">
                        <span class="text-xs font-mono text-gray-500"><%= new Date(post.updatedAt).toISOString().split('T')[0] %></span>
                        <span class="w-px h-3 bg-[#333]"></span>
                        <span class="text-xs font-bold text-amber-500"><%= post.region || '' %></span>
                    </div>
                    <h1 class="text-3xl md:text-4xl font-bold text-white mb-8 leading-tight"><%= post.title %></h1>

                    <div class="grid grid-cols-3 gap-4">
                        <div class="info-cell text-center">
                            <span class="info-label">评分</span>
                            <span class="text-xl font-bold text-amber-500"><%= post.score || '' %></span>
                        </div>
                        <div class="info-cell text-center">
                            <span class="info-label">年龄</span>
                            <span class="text-xl font-bold text-white"><%= post.age || '' %></span>
                        </div>
                        <div class="info-cell text-center">
                            <span class="info-label">价格</span>
                            <span class="text-xl font-mono font-bold text-white"><%= (post.price && post.price !== '0') ? post.price : '' %></span>
                        </div>
                    </div>
                </header>

                <section>
                    <h3 class="text-xs font-bold text-gray-500 mb-5 flex items-center gap-2 uppercase tracking-wider">
                        <span class="w-1 h-3 bg-amber-600"></span> 详情
                    </h3>
                    <div class="bg-[#050505] border border-[#1a1a1a] p-6 rounded-sm text-gray-300 text-sm leading-7 whitespace-pre-wrap font-light"><%= post.description || '' %></div>

                    <% if (post.service) { %>
                        <div class="mt-4 p-4 bg-[#0a0a0a] border-l-2 border-gray-700 text-xs text-gray-400 font-mono">
                            服务: <%= post.service %>
                        </div>
                    <% } %>
                </section>

                <section>
                    <h3 class="text-xs font-bold text-gray-500 mb-5 flex items-center gap-2 uppercase tracking-wider">
                        <span class="w-1 h-3 bg-amber-600"></span> 相册
                    </h3>
                    <% if (images && images.length) { %>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <% images.forEach(function(img, index) { %>
                                <div class="relative group aspect-square bg-[#0a0a0a] border border-[#1a1a1a] overflow-hidden cursor-zoom-in"
                                     onclick="openLightbox(<%= index %>)">
                                    <img src="<%= img.src %>" class="w-full h-full object-cover opacity-70 group-hover:opacity-100 transition-all duration-300 group-hover:scale-105"
                                         onerror="handleImgError(this)" loading="lazy">
                                    <div class="hidden flex-col items-center justify-center h-full w-full absolute inset-0 bg-[#050505]">
                                        <span class="text-[9px] font-mono text-gray-700">错误</span>
                                    </div>
                                    <div class="absolute bottom-2 right-2 opacity-0 group-hover:opacity-100 transition-opacity bg-black/50 p-1 rounded">
                                        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                                    </div>
                                </div>
                            <% }); %>
                        </div>
                    <% } else { %>
                        <div class="h-24 border border-dashed border-[#222] flex items-center justify-center text-xs text-gray-600 font-mono">
                            暂无展示
                        </div>
                    <% } %>
                </section>
            </div>

            <div class="lg:col-span-4 relative">
                <div class="sticky top-20 space-y-6">
                    <div class="bg-[#0a0a0a] border border-[#1a1a1a] p-6 rounded-sm">
                        <h3 class="text-xs font-bold text-gray-500 mb-6 uppercase tracking-widest">联系方式</h3>

                        <div class="space-y-4">
                            <% if(post.wechat) { %>
                                <div>
                                    <label class="info-label">微信</label>
                                    <div class="flex justify-between items-center bg-black border border-[#222] p-3 hover:border-amber-500/30 transition-colors group">
                                        <span class="font-mono text-sm text-gray-300 select-all group-hover:text-white"><%= post.wechat %></span>
                                    </div>
                                </div>
                            <% } %>

                            <% if(post.qq) { %>
                                <div>
                                    <label class="info-label">QQ</label>
                                    <div class="flex justify-between items-center bg-black border border-[#222] p-3 hover:border-amber-500/30 transition-colors group">
                                        <span class="font-mono text-sm text-gray-300 select-all group-hover:text-white"><%= post.qq %></span>
                                    </div>
                                </div>
                            <% } %>

                            <% if(post.phone) { %>
                                <div>
                                    <label class="info-label">手机</label>
                                    <div class="flex justify-between items-center bg-black border border-[#222] p-3 hover:border-amber-500/30 transition-colors group">
                                        <span class="font-mono text-sm text-gray-300 select-all group-hover:text-white"><%= post.phone %></span>
                                    </div>
                                </div>
                            <% } %>

                            <% if(!post.wechat && !post.qq && !post.phone) { %>
                                <div class="text-center text-xs text-gray-600 py-4 font-mono border border-dashed border-[#222]">
                                  暂无联系方式
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
